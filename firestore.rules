rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'super_admin'];
    }

    function validCartItem() {
      return request.resource.data.keys().hasOnly([
          'productId', 'quantity', 'size', 'color',
          'title', 'price', 'image', 'updatedAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 20;
    }

    match /products/{productId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /admin_settings/{settingId} {
      allow read: if settingId in ['customize', 'footer_builder'];
      allow create, update, delete: if isAdmin()
        && settingId in ['customize', 'footer_builder'];
    }

    // COMMENT MODERATION SETTINGS
    match /commentModeration/{documentId} {
      allow read, write: if isAdmin();
    }

    // COMMENT MODERATION AUDIT LOGS
    match /commentAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // COMMENT REGEX RULES
    match /commentRegexRules/{ruleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // COMMENT VIOLATIONS
    match /commentViolations/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Profile creation and sensitive profile changes must use a
      // trusted server-side flow.
      allow create, delete: if false;
      allow update: if false;

      match /cart/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && validCartItem();
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /addresses/{addressId} {
        allow read: if isOwner(uid) || isAdmin();

        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'userId', 'fullName', 'mobile', 'address',
            'landmark', 'city', 'state', 'pincode',
            'isDefault', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.userId == uid
          && request.resource.data.fullName is string
          && request.resource.data.mobile is string
          && request.resource.data.address is string
          && request.resource.data.city is string
          && request.resource.data.state is string
          && request.resource.data.pincode is string;

        allow delete: if isOwner(uid) || isAdmin();
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      // Wallets, reward balances and other private subcollections
      // remain denied unless an explicit safe rule is added.
      match /{subcollection}/{documentId} {
        allow read, write: if false;
      }
    }

    // Wishlist items are private to their owner; client updates are not used by the UI.
    match /wishlist/{wishlistId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'productId', 'productTitle', 'image', 'price'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 128
        && request.resource.data.productTitle is string
        && request.resource.data.productTitle.size() <= 200
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 2048
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000000;
      allow update: if false;
      allow delete: if (signedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Order creation and financial/status changes must go through
      // trusted server-side code.
      allow create, update, delete: if isAdmin();
    }


    // Shorts preferences: each user manages only their own preferences.
    match /interestedWatchVideos/{uid}/videos/{videoId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['videoId', 'createdAt'])
        && request.resource.data.videoId == videoId;

      allow delete: if isOwner(uid) || isAdmin();
    }

    match /notInterestedWatchVideos/{uid}/videos/{videoId} {
      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['videoId', 'createdAt'])
        && request.resource.data.videoId == videoId;

      allow delete: if isOwner(uid) || isAdmin();
    }

    // Like documents are written only by the authenticated server API.
    // Users may read only their own like records.
    match /watchVideoLikes/{likeId} {
      allow read: if (signedIn()
        && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    // Comments: clients can read approved comments only.
    // Creating, editing, and deleting comments must use trusted server APIs.
    match /comments/{commentId} {
      allow read: if resource.data.status == "approved";
      allow create, update, delete: if false;
    }

    // Users may read only their own comment-like records.
    // Writes must use the authenticated server API.
    match /videoCommentLikes/{likeId} {
      allow read: if (signedIn()
        && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
