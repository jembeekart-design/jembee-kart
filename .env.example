# Copy this file to .env.local and fill it only with values from your secret manager.
# NEVER commit .env.local or real credentials to Git/ZIP.

# Public Firebase web config (these values are visible to browsers; secure access with Firebase Rules).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APP_URL=

# Firebase Admin (server-only secrets). Use one supported credential method.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Alternative JSON credential string; do not set both methods unless intentionally managed.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Google Drive OAuth / storage integration (server-only).
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Generate a 32-byte hex value (64 hex characters); keep the same key across Preview and Production.
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Cashfree paid-video checkout (keep feature flag disabled until sandbox and live verification).
CASHFREE_PAYMENTS_ENABLED=false
CASHFREE_CREDENTIALS_ENCRYPTION_KEY=

# Paid playback token / moderation preview; server-only. Generate strong random values in secret manager.
PLAYBACK_TOKEN_SECRET=
MODERATION_PREVIEW_TOKEN_SECRET=
SHORTS_PAID_VIDEO_CHECKOUT_ENABLED=false

# Optional existing Cloudinary configuration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SIGNED_UPLOAD_PRESET=
CLOUDINARY_WEBHOOK_API_SECRET=

# LEGACY PROVIDER VARIABLES — leave blank until the provider and placement policy are re-approved.
MONETAG_API_TOKEN=
MONETAG_SITE_URL=

# SECURITY WARNING: legacy source references NEXT_PUBLIC_AI_MODERATION_KEY. Do NOT put a real AI provider secret
# in a NEXT_PUBLIC_* variable because it may be exposed to browser bundles. Keep this unset until the code is
# refactored to read a server-only AI_MODERATION_API_KEY in a server-only module.
# NEXT_PUBLIC_AI_MODERATION_KEY=
AI_MODERATION_API_KEY=
